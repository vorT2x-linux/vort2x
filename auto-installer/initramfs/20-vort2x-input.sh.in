#!/bin/sh

kernel_release="@KERNEL_RELEASE@"
module_root="/usr/lib/modules/$kernel_release/updates/vort2x"

for module in t2hid hid_t2magicmouse t2_trackpad_actuator t2_precision_trackpad apple-t2-bridge apple-t2-vhci-hcd; do
    if grep -q "^$(echo "$module" | tr - _) " /proc/modules; then
        continue
    fi

    if ! insmod "$module_root/$module.ko"; then
        warn "VorT2x: failed to load $module for $kernel_release"
        exit 1
    fi
done

info "VorT2x: T2 keyboard and trackpad modules loaded"
