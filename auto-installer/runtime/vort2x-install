#!/usr/bin/env bash

set -Eeuo pipefail

state_dir=${VORT2X_STATE_DIR:-/var/lib/vort2x-installer}
state_file="$state_dir/state"
repository=${VORT2X_REPOSITORY:-/usr/local/src/VorT2x-Fedora}
prepare=${VORT2X_PREPARE_COMMAND:-/usr/local/bin/vort2x-prepare}
repository_url=${VORT2X_REPOSITORY_URL:-https://github.com/vorT2x-linux/vort2x.git}
# Empty: the newest release tag for this Fedora. A branch name (e.g. main)
# is for development only.
repository_ref=${VORT2X_REF:-}
os_release=${VORT2X_OS_RELEASE:-/etc/os-release}
supported_file=scripts/fedora/supported-releases
repository_installer="$repository/auto-installer/runtime/vort2x-install"
self_path=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/${BASH_SOURCE[0]##*/}
lock_file="${XDG_RUNTIME_DIR:-/tmp}/vort2x-install-$(id -u).lock"

state_value() {
	local key=$1
	[[ -r "$state_file" ]] || return 1
	awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); print; exit}' "$state_file"
}

pause_on_error() {
	local status=$?
	local line=$1
	trap - ERR
	printf '\nVorT2x installation stopped at line %s (status %s).\n' "$line" "$status" >&2
	printf 'Run vort2x-install again to retry.\n' >&2
	printf 'Press any key to close this window. '
	IFS= read -r -n 1 _answer || :
	printf '\n'
	exit "$status"
}

die() {
	printf '\n%s\n' "$*" >&2
	printf 'Run vort2x-install again to retry.\n' >&2
	printf 'Press any key to close this window. '
	IFS= read -r -n 1 _answer || :
	printf '\n'
	exit 1
}

wait_for_github() {
	until git ls-remote --exit-code "$repository_url" HEAD \
		>/dev/null 2>&1; do
		printf '\nConnect to a Wi-Fi network and press any key to retry. '
		IFS= read -r -n 1 _answer
		printf '\n'
	done
}

offer_reboot() {
	local answer
	printf '\nReboot now? [Y/n] '
	read -r answer
	case "$answer" in n|N) return 0 ;; esac
	sudo systemctl reboot
}

repository_git() {
	git -c safe.directory="$repository" -C "$repository" "$@"
}

# The origin URL is a constant, not user data, so repair it instead of dying.
repair_origin_url() {
	local current
	current=$(repository_git remote get-url origin 2>/dev/null) || current=
	[[ "$current" != "$repository_url" ]] || return 0
	printf 'Repairing the VorT2x origin URL (found: %s).\n' "${current:-none}"
	if [[ -n "$current" ]]; then
		repository_git remote set-url origin "$repository_url" ||
			die "The VorT2x origin URL could not be repaired in $repository."
	else
		repository_git remote add origin "$repository_url" ||
			die "The VorT2x origin remote could not be added in $repository."
	fi
}

validate_repository() {
	[[ -d "$repository/.git" ]] ||
		die "The VorT2x Git checkout is missing: $repository"
	# A run of vort2x-install under sudo before this was blocked could have
	# left files here owned by root; repair that instead of failing on it.
	if [[ -n $(find "$repository" ! -user "$(id -u)" -print -quit 2>/dev/null) ]]; then
		printf 'Repairing ownership of %s.\n' "$repository"
		sudo chown -R "$(id -u):$(id -g)" "$repository"
	fi
	# System-managed checkout: users work in their own clone, and the installer
	# builds in-tree. Force it clean before updating rather than refusing on the
	# installer's own build leftovers.
	repository_git reset --hard
	repository_git clean -fd
	repair_origin_url
}

delegate_to_repository() {
	[[ -f "$repository_installer" && "$self_path" != "$repository_installer" ]] ||
		return 0
	validate_repository
	exec bash "$repository_installer" "$@"
}

fedora_release() {
	[[ -r "$os_release" ]] || die "$os_release is missing."
	# shellcheck disable=SC1090,SC1091
	(source "$os_release" && printf '%s\n' "${VERSION_ID:-}")
}

# The newest release tag vX.Y.Z whose supported-releases lists this Fedora.
select_release() {
	local fedora=$1 tag
	while read -r tag; do
		[[ $tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
		repository_git show "refs/tags/$tag:$supported_file" 2>/dev/null |
			awk -v want="$fedora" '{ sub(/#.*/, "") } $1 == want { found = 1 } END { exit !found }' ||
			continue
		printf '%s\n' "$tag"
		return 0
	done < <(repository_git tag --list 'v*' --sort=-version:refname)
	return 1
}

refresh_repository() {
	local previous current fedora release target
	validate_repository
	wait_for_github
	previous=$(repository_git rev-parse HEAD)
	if [[ -n "$repository_ref" ]]; then
		printf 'Using the VorT2x %s branch (development).\n' "$repository_ref"
		repository_git fetch --quiet "$repository_url" \
			"+refs/heads/$repository_ref:refs/remotes/origin/$repository_ref"
		target="refs/remotes/origin/$repository_ref"
	else
		fedora=$(fedora_release)
		printf 'Checking for the newest VorT2x release for Fedora %s...\n' "$fedora"
		repository_git fetch --quiet --force "$repository_url" '+refs/tags/v*:refs/tags/v*'
		release=$(select_release "$fedora") ||
			die "No VorT2x release supports Fedora $fedora yet."
		printf 'VorT2x release: %s\n' "$release"
		target="refs/tags/$release"
	fi
	repository_git checkout --quiet --detach "$target"
	current=$(repository_git rev-parse HEAD)

	# Once this implementation is available in the checkout, run the freshly
	# updated copy. Future releases can change the update policy in one place.
	if [[ "$self_path" == "$repository_installer" && \
		${VORT2X_INSTALL_REEXECUTED:-0} != 1 && "$previous" != "$current" ]]; then
		exec env VORT2X_INSTALL_REEXECUTED=1 bash "$repository_installer"
	fi
}

run_project_installer() {
	local mode=$1 result_label
	case "$mode" in
		initial) result_label=installation ;;
		update) result_label=update ;;
		*) die "Unknown VorT2x installer mode: $mode" ;;
	esac
	refresh_repository

	printf '\nStarting the regular VorT2x installer.\n'
	printf 'Administrator access is required.\n\n'
	sudo -v
	cd "$repository"
	if ! sudo bash ./scripts/fedora/install.sh; then
		printf '\nVorT2x attempted all independent installation steps, but reported errors.\n' >&2
		printf 'Review the error summary above and rerun vort2x-install after resolving them.\n' >&2
		printf 'The installation is not marked complete.\n' >&2
		return 1
	fi
	if [[ "$mode" == initial ]]; then
		if ! sudo "$prepare" --complete; then
			printf '\nVorT2x setup could not finalize the configured boot kernel.\n' >&2
			printf 'The installation is not marked complete. Run vort2x-install again to retry.\n' >&2
			return 1
		fi
	fi

	printf '\nVorT2x %s completed successfully.\n' "$result_label"
	printf 'Review the output above before rebooting.\n'
	if [[ "$mode" == initial ]]; then
		printf '\nNext steps:\n'
		printf '  - Repository: %s\n' "$repository"
		printf '  - Run vort2x-install at any time to update VorT2x.\n'
		printf '  - Reboot once more to start the fully configured system.\n'
	fi
	offer_reboot
}

run_initial_install() {
	local target_kernel running_kernel
	target_kernel=$(state_value target_kernel) ||
		die 'VorT2x installation state has no target kernel.'
	running_kernel=$(uname -r)
	if [[ "$running_kernel" != "$target_kernel" ]]; then
		printf 'VorT2x is waiting for Fedora kernel %s.\n' "$target_kernel"
		printf 'The currently running kernel is %s.\n' "$running_kernel"
		offer_reboot
		exit 0
	fi
	# run_project_installer already explains a failure and exits non-zero;
	# letting that reach the generic ERR trap would bury that explanation
	# under a misleading "just retry" message.
	run_project_installer initial || exit 1
}

[[ $# -eq 0 ]] || die 'usage: vort2x-install'
[[ $EUID -ne 0 ]] ||
	die 'Run vort2x-install as your normal user, not with sudo or as root. It asks for administrator access itself when it needs it.'
delegate_to_repository "$@"

# An exec within one installer session inherits the active lock and logging
# pipeline. Initializing them again would make the new process contend with
# the tee process that still owns an inherited descriptor for the same lock.
if [[ ${VORT2X_INSTALL_SESSION_ACTIVE:-0} != 1 ]]; then
	exec 9>"$lock_file"
	flock -n 9 || exit 0

	log_dir="$HOME/.local/state/vort2x"
	mkdir -p "$log_dir"
	exec > >(tee -a "$log_dir/install.log") 2>&1
	export VORT2X_INSTALL_SESSION_ACTIVE=1
fi
trap 'pause_on_error "$LINENO"' ERR

phase=$(state_value phase || printf 'pending')
case "$phase" in
	pending)
		printf 'Starting the VorT2x installer (phase 1 of 2).\n'
		printf 'Do not close this window!\n'
		printf 'Fedora will be updated before the regular VorT2x installation.\n'
		printf 'Ensure that you are connected to Wi-Fi before continuing.\n'
		printf 'Press any key to continue. '
		IFS= read -r -n 1 _answer
		printf '\n'
		printf 'Administrator access is required.\n\n'
		sudo -v
		if [[ -n "$repository_ref" ]]; then
			sudo env VORT2X_REF="$repository_ref" "$prepare"
		else
			sudo "$prepare"
		fi
		delegate_to_repository "$@"
		if [[ $(state_value target_kernel || :) == $(uname -r) ]]; then
			run_initial_install
			exit 0
		fi
		printf '\nThe updated Fedora kernel is ready.\n'
		printf 'The VorT2x installer will continue automatically after reboot.\n'
		offer_reboot
		;;
	reboot_pending)
		printf 'Continuing the VorT2x installer (phase 2 of 2).\n'
		run_initial_install
		;;
	complete)
		printf 'Starting the VorT2x updater.\n'
		run_project_installer update || exit 1
		;;
	*)
		die "Unknown VorT2x installation phase: $phase"
		;;
esac
