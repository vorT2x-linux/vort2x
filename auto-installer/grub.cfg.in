set default="0"
set timeout=5
set timeout_style=menu

terminal_input console
terminal_output console

set vort2x_efi=$root
search --no-floppy --label --set=fedora @ISO_VOLUME_LABEL@

# Must be set after the search line: GRUB expands these at assignment time.
set vort2x_common="root=live:CDLABEL=@ISO_VOLUME_LABEL@ rd.live.image inst.updates=file:///run/vort2x/updates.img initcall_blacklist=magicmouse_driver_init"
set vort2x_blacklist="acpi_tad,applesmc,macsmc,hid_apple,hid_appletb_bl,hid_appletb_kbd,hid_magicmouse,appletbdrm,apple_bce,apple_mfi_fastcharge"
set vort2x_initrd="($fedora)@ISO_INITRD_PATH@ ($vort2x_efi)/EFI/BOOT/vort2x/vort2x-input-initramfs.img ($vort2x_efi)/EFI/BOOT/vort2x/vort2x-wifi-initramfs.img"

menuentry "Start Fedora Live with VorT2x input drivers" --class fedora --class gnu-linux --class gnu --class os {
	linux ($fedora)@ISO_KERNEL_PATH@ quiet rhgb ${vort2x_common} module_blacklist=${vort2x_blacklist}
	initrd ${vort2x_initrd}
}

menuentry "Start standard Fedora Live" --class fedora --class gnu-linux --class gnu --class os {
	linux ($fedora)@ISO_KERNEL_PATH@ quiet rhgb root=live:CDLABEL=@ISO_VOLUME_LABEL@ rd.live.image
	initrd ($fedora)@ISO_INITRD_PATH@
}

# Apple firmware gives GRUB no Ctrl-X or F10, so boot options cannot be edited
# on a T2 Mac and every option set needs its own entry.

menuentry "Troubleshooting: VorT2x with boot messages" --class fedora --class gnu-linux --class gnu --class os {
	linux ($fedora)@ISO_KERNEL_PATH@ ${vort2x_common} module_blacklist=${vort2x_blacklist} plymouth.enable=0
	initrd ${vort2x_initrd}
}

menuentry "Troubleshooting: VorT2x with the dedicated GPU disabled" --class fedora --class gnu-linux --class gnu --class os {
	linux ($fedora)@ISO_KERNEL_PATH@ ${vort2x_common} module_blacklist=${vort2x_blacklist},amdgpu plymouth.enable=0
	initrd ${vort2x_initrd}
}

menuentry "Troubleshooting: VorT2x with basic graphics" --class fedora --class gnu-linux --class gnu --class os {
	linux ($fedora)@ISO_KERNEL_PATH@ ${vort2x_common} module_blacklist=${vort2x_blacklist} plymouth.enable=0 nomodeset
	initrd ${vort2x_initrd}
}

menuentry "Troubleshooting: VorT2x with basic graphics and conservative PCIe" --class fedora --class gnu-linux --class gnu --class os {
	linux ($fedora)@ISO_KERNEL_PATH@ ${vort2x_common} module_blacklist=${vort2x_blacklist},amdgpu plymouth.enable=0 nomodeset pcie_ports=compat
	initrd ${vort2x_initrd}
}
