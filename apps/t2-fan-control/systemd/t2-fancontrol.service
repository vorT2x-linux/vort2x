[Unit]
Description=T2 Fan Control daemon
After=multi-user.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/t2-fancontrol-gtk --daemon
# Hand the fans back to the SMC even after a crash or SIGKILL
ExecStopPost=-/usr/local/bin/t2-fancontrol-gtk --release
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
