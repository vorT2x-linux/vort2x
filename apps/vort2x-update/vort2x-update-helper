#!/usr/bin/env bash
# Runs the VorT2x installer for vort2x-update through pkexec.
# It accepts only names listed in scripts/fedora/update-map.
set -Eeuo pipefail

repository=/usr/local/src/VorT2x-Fedora
# The only source updates come from. The origin remote of the checkout is
# ignored, so a changed remote cannot make this root helper install other code.
repository_url=https://github.com/vorT2x-linux/vort2x.git
supported_file=scripts/fedora/supported-releases
target=

die() {
	printf 'vort2x-update-helper: %s\n' "$*" >&2
	exit 1
}

usage() {
	die 'usage: vort2x-update-helper apply --all | apply STEPS APPS | optional t2-touchbar|install-gdm-branding.sh install|remove'
}

[[ $EUID -eq 0 ]] || die 'must run as root'
[[ -n ${PKEXEC_UID:-} ]] || die 'must be started through pkexec'
[[ -d $repository/.git ]] || die "the VorT2x Git checkout is missing: $repository"

user=$(id -nu "$PKEXEC_UID") || die "unknown user $PKEXEC_UID"
home=$(getent passwd "$user" | cut -d: -f6)
owner=$(stat -c %U "$repository")

# Git runs as the owner of the checkout, so no root owned files appear in it.
repo_git() {
	runuser -u "$owner" -- git -c safe.directory="$repository" -C "$repository" "$@"
}

valid_name() {
	local name=$1
	[[ $name =~ ^[a-z0-9][a-z0-9.:-]*$ ]] || return 1
	awk -v name="$name" '$1 == name { found = 1 } END { exit !found }' \
		"$repository/scripts/fedora/update-map"
}

# Release tags as GitHub has them, "<commit> <tag>" newest first. Tags that
# exist only in the user-owned checkout never appear here, so a planted
# v99.0.0 cannot win.
remote_releases() {
	git ls-remote --tags "$repository_url" 'refs/tags/v*' |
		awk '{
			tag = $2; sub(/^refs\/tags\//, "", tag)
			peeled = sub(/\^\{\}$/, "", tag)
			if (tag !~ /^v[0-9]+\.[0-9]+\.[0-9]+$/) next
			# an annotated tag is listed twice, the ^{} line names its commit
			if (peeled || !(tag in commit)) commit[tag] = $1
		} END { for (tag in commit) print commit[tag], tag }' |
		sort -k2,2 -rV
}

# The commit of the newest release tag vX.Y.Z whose supported-releases lists
# this Fedora. vort2x-install and vort2x-update (src/git.rs) use the same
# rule. The commit comes from GitHub, not from a ref in the checkout.
select_release() {
	local fedora commit _tag
	fedora=$(. /etc/os-release && printf '%s' "${VERSION_ID:-}")
	[[ $fedora =~ ^[0-9]+$ ]] || die 'could not read the Fedora release'
	while read -r commit _tag; do
		repo_git show "$commit:$supported_file" 2>/dev/null |
			awk -v want="$fedora" '{ sub(/#.*/, "") } $1 == want { found = 1 } END { exit !found }' ||
			continue
		printf '%s\n' "$commit"
		return 0
	done < <(remote_releases)
	die "no VorT2x release supports Fedora $fedora yet, nothing was installed"
}

# Parts without a record count as installed from the current HEAD. That is
# written down before HEAD moves, so a failed run is offered again.
record_current_state() {
	local applied=/var/lib/vort2x-installer/applied head name
	head=$(repo_git rev-parse HEAD)
	install -d -m 0755 "$applied"
	repo_git show "$target:scripts/fedora/update-map" |
		awk '!/^#/ && NF && $1 != "core" { print $1 }' |
		while read -r name; do
			[[ -e $applied/$name ]] || printf '%s\n' "$head" >"$applied/$name"
		done
}

refresh_repository() {
	local release
	repo_git fetch --quiet --force --prune "$repository_url" '+refs/tags/v*:refs/tags/v*'
	release=$(select_release) || exit 1
	target=$release
	record_current_state
	repo_git reset --hard
	repo_git clean -fd
	repo_git checkout --quiet --detach "$target"
}

# Optional parts stay as they are, nothing is asked in the background.
keep_optional_parts() {
	export VORT2X_INSTALL_TOUCHBAR=0 VORT2X_INSTALL_EDDY=0 VORT2X_INSTALL_GDM_BRANDING=0
	[[ -x /usr/local/bin/vort2x-touchbar ]] && VORT2X_INSTALL_TOUCHBAR=1
	[[ -e /etc/dconf/db/gdm.d/00-vort2x ]] && VORT2X_INSTALL_GDM_BRANDING=1
	[[ -d $home/.local/share/gnome-shell/extensions/vort2x-eddy@vort2x ]] &&
		VORT2X_INSTALL_EDDY=1
	return 0
}

run_installer() {
	export SUDO_USER=$user SUDO_UID=$PKEXEC_UID
	keep_optional_parts
	cd "$repository"
	exec bash ./scripts/fedora/install.sh "$@" </dev/null
}

case ${1:-} in
	apply)
		if [[ ${2:-} == --all ]]; then
			(( $# == 2 )) || usage
			refresh_repository
			run_installer
		fi
		(( $# == 3 )) || usage
		IFS=, read -r -a steps <<<"$2"
		IFS=, read -r -a apps <<<"$3"
		refresh_repository
		# An older install.sh ignores --only and would run every step.
		grep -q -- '--only' "$repository/scripts/fedora/install.sh" ||
			die 'the installer in this release cannot run single steps yet, nothing was installed'
		for name in "${steps[@]}"; do
			valid_name "$name" || die "not an installer step: $name"
		done
		for name in "${apps[@]}"; do
			valid_name "app:$name" || die "not an app: $name"
		done
		if (( ${#apps[@]} > 0 )); then
			steps+=(install-apps.sh)
			export VORT2X_APPS=$3
		fi
		(( ${#steps[@]} > 0 )) || die 'nothing to install'
		run_installer --only "$(IFS=,; printf '%s' "${steps[*]}")"
		;;
	optional)
		# Eddy belongs to the user and needs no helper.
		(( $# == 3 )) || usage
		# Never run what happens to be in the working tree: move it to the
		# release first, like apply does.
		refresh_repository
		export SUDO_USER=$user SUDO_UID=$PKEXEC_UID
		cd "$repository"
		case $2:$3 in
			t2-touchbar:install)
				grep -q -- '--only' scripts/fedora/install.sh ||
					die 'the installer in the checkout cannot run single steps yet'
				export VORT2X_INSTALL_TOUCHBAR=1 VORT2X_APPS=t2-touchbar
				exec bash ./scripts/fedora/install.sh --only install-apps.sh </dev/null
				;;
			t2-touchbar:remove)
				bash ./apps/t2-touchbar/uninstall.sh </dev/null
				rm -f /var/lib/vort2x-installer/applied/app:t2-touchbar
				;;
			install-gdm-branding.sh:install)
				grep -q -- '--only' scripts/fedora/install.sh ||
					die 'the installer in the checkout cannot run single steps yet'
				export VORT2X_INSTALL_GDM_BRANDING=1
				exec bash ./scripts/fedora/install.sh --only install-gdm-branding.sh </dev/null
				;;
			install-gdm-branding.sh:remove)
				bash ./scripts/fedora/install-gdm-branding.sh --remove </dev/null
				rm -f /var/lib/vort2x-installer/applied/install-gdm-branding.sh
				;;
			*)
				usage
				;;
		esac
		;;
	*)
		usage
		;;
esac
