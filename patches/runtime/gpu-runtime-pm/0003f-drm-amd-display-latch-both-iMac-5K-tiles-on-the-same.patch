@@ -4628,9 +4683,12 @@ static void amdgpu_dm_commit_planes(struct drm_atomic_commit *state,
 
 		/*
 		 * Wait until we're out of the vertical blank period before the one
-		 * targeted by the flip
+		 * targeted by the flip. iMac 5K: the right tile's flip targets the
+		 * same frame as the left one, which has already waited for it, and
+		 * waiting here would hold the left tile's update lock.
 		 */
-		while ((acrtc_attach->enabled &&
+		while (!(dm->imac5k_tiles_held && pcrtc == imac5k_companion_crtc(dm)) &&
+		       (acrtc_attach->enabled &&
 			(amdgpu_display_get_crtc_scanoutpos(dm->ddev, acrtc_attach->crtc_id,
 							    0, &vpos, &hpos, NULL,
 							    NULL, &pcrtc->hwmode)
@@ -5712,6 +5770,7 @@ static void amdgpu_dm_atomic_commit_tail(struct drm_atomic_commit *state)
 	struct drm_crtc_state *old_crtc_state, *new_crtc_state;
 	unsigned long flags;
 	bool wait_for_vblank = true;
+	bool imac5k_held;
 	struct drm_connector *connector;
 	struct drm_connector_state *old_con_state = NULL, *new_con_state = NULL;
 	struct dm_crtc_state *dm_old_crtc_state, *dm_new_crtc_state;
@@ -5919,6 +5978,9 @@ static void amdgpu_dm_atomic_commit_tail(struct drm_atomic_commit *state)
 		if (new_crtc_state->async_flip)
 			wait_for_vblank = false;
 
+	/* iMac 5K: latch both tiles' updates on the same frame. */
+	imac5k_held = imac5k_hold_tiles(dm, state);
+
 	/* update planes when needed per crtc*/
 	for_each_new_crtc_in_state(state, crtc, new_crtc_state, j) {
 		dm_new_crtc_state = to_dm_crtc_state(new_crtc_state);
@@ -5927,6 +5989,9 @@ static void amdgpu_dm_atomic_commit_tail(struct drm_atomic_commit *state)
 			amdgpu_dm_commit_planes(state, dev, dm, crtc, wait_for_vblank);
 	}
 
+	if (imac5k_held)
+		imac5k_release_tiles(dm);
+
 	/* Enable writeback */
 	for_each_new_connector_in_state(state, connector, new_con_state, i) {
 		struct dm_connector_state *dm_new_con_state = to_dm_connector_state(new_con_state);
