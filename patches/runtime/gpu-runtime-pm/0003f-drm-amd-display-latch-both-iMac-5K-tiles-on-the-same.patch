diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 4adc9ee..6fbd626 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -4190,6 +4190,61 @@ static int imac5k_allow_added_crtc(struct amdgpu_display_manager *dm,
 	return 0;
 }
 
+/*
+ * iMac 5K: the two tiles are programmed by two calls to
+ * amdgpu_dm_commit_planes(), one per CRTC. Without a lock spanning both, a
+ * VSync between them latches the left tile's new frame one refresh before the
+ * right one's. For fast updates of both tiles, hold both pipes' update locks
+ * from before the left tile is programmed until after the right one is.
+ */
+static bool imac5k_hold_tiles(struct amdgpu_display_manager *dm,
+			      struct drm_atomic_commit *state)
+{
+	struct drm_crtc *comp = imac5k_companion_crtc(dm);
+	struct drm_crtc_state *crtc_state, *left_state = NULL, *comp_state;
+	struct dm_crtc_state *dm_left, *dm_comp;
+	struct drm_crtc *crtc;
+	int i;
+
+	if (!comp)
+		return false;
+
+	comp_state = drm_atomic_get_new_crtc_state(state, comp);
+	if (!comp_state)
+		return false;
+
+	for_each_new_crtc_in_state(state, crtc, crtc_state, i) {
+		if (amdgpu_dm_imac5k_crtc_is_left(dm, crtc))
+			left_state = crtc_state;
+	}
+	if (!left_state || !left_state->active || !comp_state->active ||
+	    drm_atomic_crtc_needs_modeset(left_state) ||
+	    drm_atomic_crtc_needs_modeset(comp_state))
+		return false;
+
+	dm_left = to_dm_crtc_state(left_state);
+	dm_comp = to_dm_crtc_state(comp_state);
+	if (!dm_left->stream || !dm_comp->stream ||
+	    dm_left->update_type != UPDATE_TYPE_FAST ||
+	    dm_comp->update_type != UPDATE_TYPE_FAST)
+		return false;
+
+	mutex_lock(&dm->dc_lock);
+	dm->imac5k_tiles_held = dc_imac5k_hold_tile_locks(dm->dc, dm_left->stream,
+							  dm_comp->stream);
+	mutex_unlock(&dm->dc_lock);
+
+	return dm->imac5k_tiles_held;
+}
+
+static void imac5k_release_tiles(struct amdgpu_display_manager *dm)
+{
+	mutex_lock(&dm->dc_lock);
+	dc_imac5k_release_tile_locks(dm->dc);
+	dm->imac5k_tiles_held = false;
+	mutex_unlock(&dm->dc_lock);
+}
+
