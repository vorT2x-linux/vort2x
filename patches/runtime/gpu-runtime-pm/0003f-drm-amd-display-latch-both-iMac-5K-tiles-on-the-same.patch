 }
 
+/**
+ * dc_imac5k_hold_tile_locks() - Lock both iMac 5K tiles across their updates
+ * @dc: DC instance
+ * @left: stream of the left tile
+ * @right: stream of the right tile
+ *
+ * The two tiles of the 5K panel are separate streams, updated one after the
+ * other. Take the update lock of both pipes and keep it held through the
+ * updates (dce_pipe_control_lock() leaves held pipes alone), so that neither
+ * tile can latch its new frame on a VSync that the other one misses.
+ * dc_imac5k_release_tile_locks() releases both locks back to back.
+ *
+ * Only for DCE, whose pipe lock is not taken by interdependent_update_lock(),
+ * and only around fast updates: DC does not wait for a flip to latch while
+ * applying one.
+ *
+ * Return: true if the locks are held.
+ */
+bool dc_imac5k_hold_tile_locks(struct dc *dc,
+			       const struct dc_stream_state *left,
+			       const struct dc_stream_state *right)
+{
+	struct pipe_ctx *pipes[2];
+	u32 mask = 0;
+	int i;
+
+	if (!dc->config.imac5K_support || dc->hwss.interdependent_update_lock ||
+	    !dc->hwss.pipe_control_lock || dc->imac5k_held_tg_mask)
+		return false;
+
+	pipes[0] = resource_get_otg_master_for_stream(&dc->current_state->res_ctx, left);
+	pipes[1] = resource_get_otg_master_for_stream(&dc->current_state->res_ctx, right);
+	if (!pipes[0] || !pipes[1])
+		return false;
+
+	for (i = 0; i < 2; i++) {
+		dc->hwss.pipe_control_lock(dc, pipes[i], true);
+		mask |= BIT(pipes[i]->stream_res.tg->inst);
+	}
+
+	dc->imac5k_held_tg_mask = mask;
+
+	return true;
+}
+
+/**
+ * dc_imac5k_release_tile_locks() - Release the locks of dc_imac5k_hold_tile_locks()
+ * @dc: DC instance
+ */
+void dc_imac5k_release_tile_locks(struct dc *dc)
+{
+	u32 mask = dc->imac5k_held_tg_mask;
+	unsigned int i;
+
+	if (!mask)
+		return;
+
+	dc->imac5k_held_tg_mask = 0;
+
+	for (i = 0; i < dc->res_pool->pipe_count; i++) {
+		struct pipe_ctx *pipe = &dc->current_state->res_ctx.pipe_ctx[i];
+
+		if (pipe->stream && resource_is_pipe_type(pipe, OTG_MASTER) &&
+		    (mask & BIT(pipe->stream_res.tg->inst)))
+			dc->hwss.pipe_control_lock(dc, pipe, false);
+	}
+}
+
 void dc_trigger_sync(struct dc *dc, struct dc_state *context)
 {
 	if (context->stream_count > 1 && !dc->debug.disable_timing_sync) {
